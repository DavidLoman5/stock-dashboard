# debug-only full engine output (476KB/day); page reads inline spliced data, not this file
screen-result.json
# per-day panel cache for backtest.ps1 (rebuildable from TWSE, ~30MB)
backtest-cache/
# per-(code,month) completed-month kline cache for screen.ps1 (rebuildable from TWSE/TPEx)
kline-cache/
# server mode: everything below is per-deployment and MUST NOT be committed.
# data/ holds the JSON the server serves (rebuildable); *.db holds real users' portfolios.
data/
*.db
*.db-wal
*.db-shm
config.json
# Gemini's per-code notes for guests. Not secret in itself (it is analysis of public market
# data), but its key set is the union of every user's holdings - publishing it would disclose
# which codes people here hold. The server reads it from disk; nothing needs it in the repo.
guest-notes.json
# derived each morning from holdings-notes.json purely so the AI step can read ~1KB instead of
# the whole file; nothing reads it afterwards, so it is churn in every diff
prev-recs.json
# overnight.ps1's snapshot of the US drivers of tomorrow's open. Rewritten daily, and the only
# file here whose numbers are third-party (Yahoo) rather than the exchange's - it is context for
# the analysis step, not a figure this project publishes.
overnight-context.json
# Owner-derived daily artifacts. Every one of these was committed to the public repo until
# 2026-07-25, because the privacy check only ever looked at index.html while `git add -A`
# published the whole tree. Nothing needs them in git - build-demo.ps1, publish.ps1,
# server/payload.py and run-daily.sh all read the working copy.
#   holdings-notes.json    the owner's per-code `rec` advice and _market.wind
#   holdings-context.json  the owner's whole portfolio: codes, names, prices, MAs, chip data
#   stance-log.json        rule-engine stance history, keyed by the owner's holdings
# Untracking stance-log.json also means git no longer backs up that history: it is append-only
# on disk and evaluate.ps1 refuses to run rather than overwrite it, but it is now local-only.
holdings-notes.json
holdings-context.json
stance-log.json
__pycache__/
*.pyc
